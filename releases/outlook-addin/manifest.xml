<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPane">
  <Id>3fe9f600-7fab-4c06-92d3-4d7d4f2ce4d1</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Writing Assistant</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Writing Assistant"/>
  <Description DefaultValue="AI writing assistant for Outlook composer"/>
  <IconUrl DefaultValue="https://localhost:3000/icon.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/support"/>
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteMailbox</Permissions>
</OfficeApp>
